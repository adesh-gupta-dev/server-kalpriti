NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:8081
# Production: exact HTTPS origins only; localhost/LAN access is development-only.
CORS_ORIGINS=
# Set to the precise trusted proxy hop count or CIDRs provided by your host.
TRUST_PROXY=

# PostgreSQL application database; use your provider's SSL connection parameters.
DATABASE_URL=postgresql://kalpriti:change-me@127.0.0.1:55432/kalpriti_test
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Local Docker PostgreSQL (set this to match DATABASE_URL).
POSTGRES_USER=kalpriti
POSTGRES_DB=kalpriti_test
POSTGRES_PORT=55432
POSTGRES_PASSWORD=change-me

# Read-only legacy import source. These are not used by the running API.
MONGODB_URI=
MONGODB_DATABASE=

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_IN=7
RATE_LIMITER_TIME=15
MAX_LIMIT_PACKAGE=300
AUTH_RATE_LIMIT_MAX=10
# Set REDIS_URL when scaling beyond a single API instance.
DEPLOYMENT_INSTANCES=1
REDIS_URL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=465
SMTP_MAIL=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=
AI_TIMEOUT_MS=60000
